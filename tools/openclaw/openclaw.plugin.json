{
  "id": "ai-passport-openclaw",
  "name": "AI Passport Agent \u2014 OpenClaw",
  "description": "Bounded audio transport using native device authentication and Talk sessions",
  "categories": [
    "infrastructure"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "upstreamProvider": {
        "type": "string",
        "default": "openai"
      },
      "maxConnections": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32,
        "default": 4
      },
      "speech": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "host",
              "openai"
            ]
          },
          "apiKeyEnv": {
            "type": "string"
          },
          "apiKeyFile": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        }
      }
    }
  }
}
